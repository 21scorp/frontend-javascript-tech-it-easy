{
  "name": "tidefall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TIDEFALL — a portrait-first idle/tycoon/RPG. Gather, craft, fight, build.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5181",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/progression/sim.ts",
    "build:single": "SINGLE=1 vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "playwright": "^1.50.0",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
